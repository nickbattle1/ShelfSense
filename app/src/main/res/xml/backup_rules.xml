<?xml version="1.0" encoding="utf-8"?>
<!-- android 11 and lower. allowBackup is off in the manifest, and this keeps every
     domain excluded too, since Firestore is where the pantry is backed up -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
